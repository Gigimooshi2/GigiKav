<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/trip_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/trip_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/trip_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/trip_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_item_bg"
            android:contentDescription="Refresh"
            android:gravity="center"
            android:text="↻"
            android:textColor="#CCFFFFFF"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/trip_edit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_item_bg"
            android:contentDescription="Edit widget"
            android:gravity="center"
            android:text="✎"
            android:textColor="#CCFFFFFF"
            android:textSize="18sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/trip_note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/trip_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />
</LinearLayout>
